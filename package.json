{
  "name": "chirp",
  "version": "0.1.0",
  "description": "A Clippy-style desktop companion for OpenCode",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
